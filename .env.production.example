# ==============================================================================
# SRE Platform — Production Environment (.env.production.example)
# ==============================================================================

# [NEON POSTGRESQL]
# Direct connection for schema migrations and CLI commands:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Pooled connection for production web and API request handling:
POSTGRES_PRISMA_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# [NEXTAUTH & RBAC]
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32_KEY"
NEXTAUTH_URL="https://sretrack.vercel.app"
SUPER_ADMIN_EMAIL="myselfgowtham140707@gmail.com"

# [BACKGROUND JOBS & CRON]
CRON_SECRET="REPLACE_WITH_SECURE_CRON_BEARER_TOKEN"

# [FRONTEND CONFIGURATION (Vercel)]
NEXT_PUBLIC_SITE_NAME="SRE Track"
NEXT_PUBLIC_SITE_URL="https://sretrack.vercel.app"
NEXT_PUBLIC_CANONICAL_URL="https://sretrack.vercel.app"

# If Hostless hosts the backend independently, set the backend API domain:
# NEXT_PUBLIC_API_URL="https://api.sretrack.com"
# BACKEND_API_URL="https://api.sretrack.com"

# [OPTIONAL AI INTEGRATION TOKENS]
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
POLLINATIONS_API_KEY=""

# [SERVER RUNTIME (Hostless)]
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

