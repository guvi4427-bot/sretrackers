# ==============================================================================
# SRE Platform — Unified Environment Variable Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string (Used for Prisma migrations & CLI)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Pooled connection string (Recommended for runtime traffic on serverless / Vercel)
POSTGRES_PRISMA_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Vercel & Hostless)
# ------------------------------------------------------------------------------
# Random 32+ byte string generated via: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-replace-in-production"

# Canonical URL of the platform (Must include https:// in production)
NEXTAUTH_URL="http://localhost:3000"

# Super Admin email for permission escalation
SUPER_ADMIN_EMAIL="myselfgowtham140707@gmail.com"

# Background Job Authentication Secret (Protects /api/cron/*)
CRON_SECRET="your-secure-cron-secret-token"

# ------------------------------------------------------------------------------
# 3. SITE BRANDING & CANONICAL SEO (Vercel Frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="SRE Track"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CANONICAL_URL="https://sretrack.vercel.app"

# Optional cross-origin backend API URL (Leave blank if running same-origin / proxy)
NEXT_PUBLIC_API_URL=""

# ------------------------------------------------------------------------------
# 4. AI SERVICE PROVIDERS (Optional / Tiered Fallback in Hostless & Vercel)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
ZAI_API_KEY=""
POLLINATIONS_API_KEY=""

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME (Hostless Backend)
# ------------------------------------------------------------------------------
PORT=3000
HOSTNAME="0.0.0.0"
NODE_ENV="development"

